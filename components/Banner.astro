---
import Default from '@astrojs/starlight/components/Banner.astro';

const docsHome = process.env.DOCS_HOME || 'https://f5-sales-demo.github.io/';
const { sidebar, entry, siteTitle, editUrl } = Astro.locals.starlightRoute;
const t = Astro.locals.t;

const isIndexPage = entry.filePath ? /(?:^|[\\/])index\.mdx?$/.test(entry.filePath) : false;
const certificateManagement = import.meta.env.F5_DOCS_REPOSITORY === 'f5-sales-demo/certificate-management';
const hideBreadcrumbs = isIndexPage && !certificateManagement;

function findTrail(entries: typeof sidebar, trail: { label: string; href?: string }[] = []): { label: string; href?: string }[] | null {
  for (const item of entries) {
    if (item.type === 'link' && item.isCurrent) {
      return trail;
    }
    if (item.type === 'group') {
      const overview = item.entries.find((child) => child.type === 'link');
      const href = certificateManagement && overview?.type === 'link' ? overview.href : undefined;
      const result = findTrail(item.entries, [...trail, { label: item.label, href }]);
      if (result) return result;
    }
  }
  return null;
}

const trail = findTrail(sidebar) || [];
const fixedEditUrl = editUrl ? editUrl.href.replace('/src/content/docs/', '/docs/') : undefined;
---

<Default {...Astro.props}><slot /></Default>
{!hideBreadcrumbs && (
  <nav class="breadcrumbs" data-certificate-management={certificateManagement || undefined} aria-label={t('f5xc.breadcrumb.label')}>
    <ol>
      <li><a href={docsHome}>{t('f5xc.breadcrumb.home')}</a></li>
      <li><a href={import.meta.env.BASE_URL}>{siteTitle}</a></li>
      {trail.map((crumb) => (
        <li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}</li>
      ))}
      <li aria-current="page"><span>{certificateManagement ? entry.data.sidebar?.label || entry.data.title : entry.data.title}</span></li>
    </ol>
    {fixedEditUrl && (
      <a href={fixedEditUrl} target="_blank" rel="noopener noreferrer" class="edit-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
          <path d="m15 5 4 4" />
        </svg>
        <span>{t('f5xc.breadcrumb.edit')}</span>
      </a>
    )}
  </nav>
)}

<script>
  import { installCertificateBreadcrumbOffset } from "../src/utils/breadcrumb-offset.ts";
  installCertificateBreadcrumbOffset();
  document.addEventListener("astro:page-load", installCertificateBreadcrumbOffset);
</script>

<style is:global>
/* Starlight scroll padding already reserves the header and mobile TOC. */
html:has(.breadcrumbs[data-certificate-management]) main :is(h1, h2, h3, h4, h5, h6) {
  scroll-margin-top: var(--f5-certificate-breadcrumb-height, 3rem);
}
</style>
