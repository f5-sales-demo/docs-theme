---
import MegaMenu from './SharedMegaMenu.tsx';
import MegaMenuMobile from './SharedMegaMenuMobile.tsx';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import config from 'virtual:starlight/user-config';
import { sharedMode, baseline } from '../src/shared/settings.mjs';
import { stagedProviderSections } from '../src/utils/provider-sections.ts';
const mode = sharedMode();
const providerSections = process.env.DOCS_PROFILE === 'canonical-provider' ? stagedProviderSections() : [];
const base = (process.env.DOCS_BASE || '/').replace(/\/+$/, '') + '/';
const consumer = { contract: 'v1', repository: process.env.GITHUB_REPOSITORY, documentBase: base, locale: Astro.currentLocale || 'en', mounts: { desktop: '#f5-ecosystem-desktop', mobile: '#f5-ecosystem-mobile' } };


/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header sl-mega-menu-header" data-f5-shared-consumer={mode !== 'local' ? JSON.stringify(consumer) : undefined} data-f5-shared-baseline={mode !== 'local' ? JSON.stringify(baseline.pointer) : undefined}>
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="smm-desktop-nav" id="f5-ecosystem-desktop" aria-label="Ecosystem">
		<MegaMenu client:only="react" />
	</nav>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
	<div class="smm-mobile-toggle" id="f5-ecosystem-mobile">
		<MegaMenuMobile client:only="react" />
	</div>
	<details class="compact-preferences">
		<summary aria-label="Display and language">Aa</summary>
		<div class="preferences-panel"><ThemeSelect /><LanguageSelect /></div>
	</details>
</div>

<script>
  import { startSharedShell } from '../src/shared/bootstrap.mjs';
  const header = document.querySelector<HTMLElement>('[data-f5-shared-consumer]');
  if (header) startSharedShell(JSON.parse(header.dataset.f5SharedConsumer!), JSON.parse(header.dataset.f5SharedBaseline!)).catch(() => {});
</script>
{providerSections.length > 0 && <nav class="provider-local-nav" aria-label="Provider documentation">
  {providerSections.map(section => <a href={`${base}${section.path}/`}>{section.label}</a>)}
</nav>}
