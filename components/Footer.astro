---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

{process.env.DOCS_PROFILE !== 'canonical-provider' && <nav class="project-links" aria-label="Project information">
  <a href="https://f5-sales-demo.github.io/en/ecosystem/">Ecosystem directory</a>
  <a href="https://github.com/f5-sales-demo">Project sources</a>
  <a href="https://docs.cloud.f5.com/">Official F5 documentation</a>
</nav>}

<style>
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 2rem;
    padding-block: 1rem;
  }
  .project-links a { padding-block: 0.5rem; }
</style>
