---
import ProviderReference from './ProviderReference.astro';

const canonical = process.env.DOCS_PROFILE === 'canonical-provider';

import ImageZoom from 'starlight-image-zoom/components/ImageZoom.astro';
import StarlightVideosMarkdownContent from 'starlight-videos/components/MarkdownContent.astro';
---

{!canonical && <ImageZoom />}
{canonical ? <div class="sl-markdown-content"><ProviderReference><slot /></ProviderReference></div> : <StarlightVideosMarkdownContent><slot /></StarlightVideosMarkdownContent>}
